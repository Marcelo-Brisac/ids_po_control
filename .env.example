# Django settings
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Ports (optional — defaults: WEB_PORT=8000, DB_PORT=5432)
WEB_PORT=8000
DB_PORT=5432


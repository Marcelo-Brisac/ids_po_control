# DB_PORT=5433

# Database
DATABASE_URL=postgres://ids_po_user:ids_po_password_2026@db:5432/ids_po_control

# Autentique digital signature API
AUTENTIQUE_API_KEY=
AUTENTIQUE_FOLDER=
